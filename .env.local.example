# Wix Headless client ID (public — safe to expose to the browser).
# Pre-filled with the MegaDeal Headless Backend project's web OAuth app.
# Create your own at your project's Headless Settings if you fork this for a
# different Wix backend: https://www.wix.com/my-account/site-selector
NEXT_PUBLIC_WIX_CLIENT_ID=a5df1008-85ea-4479-8a49-8b0576ae9714

# Server-only. Required for admin/portal API routes (lib/wixAdmin.ts).
WIX_API_KEY=
WIX_SITE_ID=d16d601e-327a-4a80-9aed-2d951bc256ad

# Server-only. Resend (resend.com) sends this app's transactional emails
# (lib/sendEmail.ts) and syncs verified customer signups into a Resend
# Audience for marketing broadcasts (lib/resendAudience.ts). Requires the
# sending domain (megadeal.co.nz) to be verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Server-only. Inbox that gets notified (via Resend) when someone submits
# the contact form (app/api/contact/route.ts). Any address works — it
# doesn't need to be on the verified sending domain.
ADMIN_NOTIFY_EMAIL=

# Server-only. Google Places API (New) key for merchant address autocomplete
# (app/api/places/*). Deliberately NOT prefixed NEXT_PUBLIC_ — calls are
# proxied through our own API routes so the key never reaches the browser,
# and every call is gated by a site-wide daily quota tracked in Wix Data
# (lib/placesUsageLimiter.ts) as a hard backstop against runaway billing.
# In the Google Cloud key's own restrictions, set "Application restrictions"
# to None (it's never called from a browser) and "API restrictions" to just
# Places API (New). Falls back to a free keyless geocoder automatically
# when unset, over quota, or the request fails — this feature is optional.
GOOGLE_PLACES_API_KEY=
