# Server-only. Inbox that gets notified when someone submits the contact
# form (app/api/contact/route.ts), and the reply-to on the merchant welcome
# email (app/api/merchants/apply/route.ts). Any address works.
ADMIN_NOTIFY_EMAIL=

# Server-only. Google Places API (New) key for merchant address autocomplete
# (app/api/places/*). Deliberately NOT prefixed NEXT_PUBLIC_ — calls are
# proxied through our own API routes so the key never reaches the browser,
# and every call is gated by a site-wide daily quota tracked in the database
# (lib/placesUsageLimiter.ts) as a hard backstop against runaway billing.
# In the Google Cloud key's own restrictions, set "Application restrictions"
# to None (it's never called from a browser) and "API restrictions" to just
# Places API (New). Falls back to a free keyless geocoder automatically
# when unset, over quota, or the request fails — this feature is optional.
GOOGLE_PLACES_API_KEY=
