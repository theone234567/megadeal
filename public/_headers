# How long browsers keep the site's own files. Read by Cloudflare's static
# assets (https://developers.cloudflare.com/workers/static-assets/headers).
# Without it every file was sent with max-age=0, so each visit re-checked
# every script, stylesheet, font and image with the server before using it.

# Scripts, styles and fonts built by Next. Their names change whenever
# their contents do, so a copy can be kept for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The site's own pictures in public/ (logos, mascot, category and example
# photos): never deals, prices, pages or businesses' uploaded photos
# (/media), which aren't covered here. Kept for a week (was a day: PageSpeed
# flagged it), then used while a fresh copy is fetched in the background
# for up to a month. These only change with a deploy; a changed picture
# gets a new file name so it shows at once.
/megadeal/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/branding/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/homepage/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/megadeal-coming-soon/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/badge/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
