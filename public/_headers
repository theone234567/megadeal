# How long browsers keep the site's own files. Read by Cloudflare's static
# assets (https://developers.cloudflare.com/workers/static-assets/headers).
# Without it every file was sent with max-age=0, so each visit re-checked
# every script, stylesheet, font and image with the server before using it.

# Scripts, styles and fonts built by Next. Their names change whenever
# their contents do, so a copy can be kept for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images in public/. These keep their names when replaced, so they're kept
# for a day, then used while a fresh copy is fetched in the background for
# up to a week. A replaced image shows within a day; give it a new file
# name to show it at once.
/megadeal/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/branding/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/homepage/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/badge/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
